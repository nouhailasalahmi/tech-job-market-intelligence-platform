"""
Tests de normalizer.py : verifient les 3 corrections (+ null) et la vraie taxonomie.
Lancer :  pytest
"""
import textwrap

import pytest

from src.nlp.normalizer import DEFAULT_TAXONOMY, load_taxonomy


def write_yaml(tmp_path, content: str):
    path = tmp_path / "taxonomy.yaml"
    path.write_text(textwrap.dedent(content), encoding="utf-8")
    return path


def by_name(skills):
    return {s.name: s for s in skills}


# ----------------------------------------------------------- les corrections --
def test_motif_en_texte_simple_n_est_pas_decoupe_en_lettres(tmp_path):
    """Correction 1 : `Python: '\\bpython\\b'` (texte, pas liste) ne doit pas matcher un simple 'p'."""
    path = write_yaml(tmp_path, r"""
        languages:
          Python: '\bpython\b'
    """)
    python = by_name(load_taxonomy(path))["Python"]
    assert python.regex.search("Je code en Python")
    assert not python.regex.search("zzz p zzz")


def test_motif_vide_est_ignore(tmp_path):
    """Correction 2 : un motif vide matcherait partout."""
    path = write_yaml(tmp_path, """
        misc:
          Foo: ['', '   ', 'foo']
    """)
    foo = by_name(load_taxonomy(path))["Foo"]
    assert foo.regex.search("un foo ici")
    assert not foo.regex.search("rien a voir")


def test_motif_null_est_ignore(tmp_path):
    """Correction 2 : `null` dans la liste ne doit pas devenir le mot 'None'."""
    path = write_yaml(tmp_path, """
        misc:
          Foo: [null, 'foo']
    """)
    foo = by_name(load_taxonomy(path))["Foo"]
    assert not foo.regex.search("none of the above")


def test_motif_numerique_est_converti_en_texte(tmp_path):
    """Correction 2 : un nombre dans le YAML ne doit pas faire planter re.compile."""
    path = write_yaml(tmp_path, """
        misc:
          Foo: [123]
    """)
    foo = by_name(load_taxonomy(path))["Foo"]
    assert foo.regex.search("poste 123")


def test_motif_invalide_est_ignore_mais_les_autres_restent(tmp_path):
    path = write_yaml(tmp_path, """
        misc:
          Foo: ['(parenthese ouverte', 'foo']
    """)
    foo = by_name(load_taxonomy(path))["Foo"]
    assert foo.regex.search("foo")


def test_competence_sans_aucun_motif_valide_est_ignoree(tmp_path):
    path = write_yaml(tmp_path, """
        misc:
          Foo: ['(parenthese ouverte']
          Bar: []
          Baz:
    """)
    assert load_taxonomy(path) == []


def test_competence_en_double_garde_la_premiere(tmp_path):
    path = write_yaml(tmp_path, """
        a:
          Foo: ['foo']
        b:
          Foo: ['bar']
    """)
    skills = load_taxonomy(path)
    assert len(skills) == 1
    assert skills[0].category == "a"
    assert not skills[0].regex.search("bar")


def test_recherche_insensible_a_la_casse(tmp_path):
    path = write_yaml(tmp_path, r"""
        languages:
          Python: ['\bpython\b']
    """)
    python = by_name(load_taxonomy(path))["Python"]
    assert python.regex.search("PYTHON, python, Python")


def test_plusieurs_variantes_sont_combinees(tmp_path):
    path = write_yaml(tmp_path, r"""
        libraries:
          Scikit-learn: ['scikit.?learn', '\bsklearn\b']
    """)
    sk = by_name(load_taxonomy(path))["Scikit-learn"]
    assert sk.regex.search("scikit-learn")
    assert sk.regex.search("from sklearn import svm")
    assert sk.category == "libraries"


# ---------------------------------------------------- vraie taxonomie du projet --
real_taxonomy = pytest.mark.skipif(not DEFAULT_TAXONOMY.exists(),
                                   reason="config/skills_taxonomy.yaml introuvable")


def found(text: str) -> set[str]:
    return {s.name for s in load_taxonomy() if s.regex.search(text)}


@real_taxonomy
def test_la_taxonomie_reelle_se_charge():
    assert len(load_taxonomy()) > 30


@real_taxonomy
def test_python_et_sql_sont_detectes():
    assert {"Python", "SQL"} <= found("Maitrise de Python et SQL exigee")


@real_taxonomy
def test_java_ne_matche_pas_javascript():
    names = found("Developpeur JavaScript confirme")
    assert "JavaScript" in names
    assert "Java" not in names


@real_taxonomy
def test_sql_ne_matche_pas_nosql():
    assert "SQL" not in found("Experience avec des bases NoSQL")


@real_taxonomy
def test_cpp_est_detecte():
    assert "C++" in found("Ingenieur C++ embarque")


@real_taxonomy
def test_pas_de_faux_positif_sur_un_texte_sans_competence():
    assert found("Nous recherchons une personne motivee, rigoureuse et sympathique.") == set()